## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
[Ll]og/
*.log

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Mono Auto Generated Files
mono_crash.*

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config history
.vs/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
packages/
*.snupkg

# Microsoft Azure Web Apps
.azure/

# Rider
.idea/
*.sln.iml

# Resharper
_ReSharper*/
*.DotSettings.user

# DotCover
*.dotCover

# Backup & publish files
*.bak
*.publishsettings
publish/

# Others
*.dbmdl
*.psess
*.vsp
*.vspscc
*.vssscc

# Entity Framework Migrations History
Migrations/

# Logs and crash dumps
*.pidb
*.mdb
*.stackdump
