@page
@model HomeFix.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-body">
                    <h2 class="text-center mb-4">@ViewData["Title"]</h2>
                    <p class="text-center">Bạn có chắc chắn muốn đăng xuất?</p>
                    <form method="post">
                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary">Đăng xuất</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 